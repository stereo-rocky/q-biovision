# ----------------------------------------------------------------------------
# Q-BioVision - frontend environment variables
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# (NEXT_PUBLIC_* does nothing here - this app is Vite, not Next.js.)
# ----------------------------------------------------------------------------

# Backend ORIGIN only - do NOT include a trailing /api, the client adds it.
# Leave EMPTY to use same-origin requests (Vite proxy in dev,
# vercel.json rewrites in production). Recommended default.
VITE_API_URL=

# Where the Vite dev server proxies /api during `npm run dev`.
VITE_DEV_API_PROXY=http://localhost:8000
